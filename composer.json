{
    "name": "hgabka/settings-bundle",
    "type": "symfony-bundle",
    "description": "Settings bundle",
    "keywords": [],
    "homepage": "https://github.com/hgabka/settings-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Gabe",
            "email": "hgabka@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0.2",
        "a2lix/translation-form-bundle": "^3.0|^4.0",
        "doctrine/inflector": "^2.0",
        "hgabka/utils-bundle": "^7.1|^8.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/framework-bundle": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Hgabka\\SettingsBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hgabka\\SettingsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
